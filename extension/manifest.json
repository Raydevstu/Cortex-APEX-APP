{
  "manifest_version": 3,
  "name": "CortexOS — Persistent AI Brain",
  "version": "0.2.0",
  "description": "Rewrite raw prompts into Tier-1 enterprise specifications and inject cross-platform project memory (sync packets) into any AI chat — ChatGPT, Claude, Gemini, Codex web, Bolt, v0 and more.",
  "permissions": ["storage", "contextMenus", "activeTab", "scripting", "alarms"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CortexOS",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["lib/core.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "cortex-rewrite-prompt": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "Command+Shift+Space"
      },
      "description": "Rewrite the current chat input into a Tier-1 prompt",
      "global": true
    },
    "cortex-inject-state": {
      "suggested_key": {
        "default": "Ctrl+Shift+V",
        "mac": "Command+Shift+V"
      },
      "description": "Inject the CortexOS sync packet into the current chat input",
      "global": true
    }
  }
}
